[Unit]
Description=Initialise /home on first boot (persistent home partition)
Documentation=file:///usr/lib/sequoia-home-init/sequoia-home-init.sh
After=local-fs.target
Before=getty.target sshd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/sequoia-home-init/sequoia-home-init.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

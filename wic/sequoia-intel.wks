# Sequoia Intel (LattePanda) — A/B OTA partition layout
#
# GPT disk image:
#
# p1  /boot/efi   256 MB  FAT32  GRUB EFI bootloader + grub.cfg + grubenv
# p2  /           8192 MB ext4   rootfs-a  (active slot, populated at build time)
# p3  <none>      8192 MB ext4   rootfs-b  (standby slot, written by SWUpdate)
# p4  /home       512 MB → grows persistent home (expanded on first boot)
#
# A/B update flow:
#   1. pre-install.sh  detects the inactive slot via partition LABEL/PARTLABEL,
#      creates /dev/swupdate-inactive symlink.
#   2. SWUpdate "raw" handler streams rootfs.ext4.gz onto the inactive partition.
#   3. post-install.sh relabels the new filesystem (e2label) so GRUB's
#      "search --label" can find it, then updates /boot/efi/EFI/BOOT/grub.cfg
#      by replacing the rootfs label reference.  EFI partition is mounted
#      read-write for the edit, then restored to read-only.
#   4. swupdate.cfg triggers `reboot` via postupdatecmd.
#
# Flash with:
#   bmaptool copy --bmap sequoia-image.wic.bmap sequoia-image.wic.bz2 /dev/sdX
#   (replace /dev/sdX with the actual block device: /dev/sda, /dev/nvme0n1, …)

bootloader --ptable gpt --timeout 3

# ── EFI System Partition ──────────────────────────────────────────────────────
# GRUB EFI binary + grub.cfg (custom A/B-aware, provided by sequoia-grub-cfg
# recipe via GRUB_CFG = "${STAGING_DATADIR}/grub-efi/grub.cfg").
# install-kernel-into-bootdir=false: kernel stays in rootfs at /boot/bzImage,
# GRUB uses "search --label" to find the rootfs partition then loads the kernel.
part /boot/efi --source bootimg-efi --sourceparams "format=grub-efi,loader=grub-efi,install-kernel-into-bootdir=false" --ondisk sda --fstype=vfat --label efi --active --align 1024 --fixed-size 256M

# ── rootfs-a (active slot) ────────────────────────────────────────────────────
part / --source rootfs --ondisk sda --fstype=ext4 --label rootfs-a --align 1024 --fixed-size 8192M

# ── rootfs-b (standby slot) ───────────────────────────────────────────────────
# Empty at build time, SWUpdate streams the compressed rootfs image here during
# OTA.  post-install.sh relabels it with e2label after the write.
part --source empty --ondisk sda --fstype=ext4 --label rootfs-b --align 1024 --fixed-size 8192M

# ── /home (persistent across OTA) ────────────────────────────────────────────
# Created at 512 MB here so the .wic image stays small.
# sequoia-home-init.service expands it to fill the actual storage on first boot.
part /home --source empty --ondisk sda --fstype=ext4 --label home --align 1024 --fixed-size 512M

# Sequoia Intel x86 disk image - EFI A/B OTA layout
#
# p1  /boot      256 MB  FAT32  EFI System Partition (systemd-boot entries)
# p2  /          8192 MB ext4   rootfs-a (active at factory flash)
# p3  <none>     8192 MB ext4   rootfs-b (standby, written by SWUpdate)
# p4  /home      1024 MB ext4   persistent home, grown to fill disk on first boot

part /boot --source bootimg-efi --sourceparams="loader=systemd-boot" --ondisk sda --fstype=vfat --label boot --active --align 1024 --fixed-size 256M

part / --source rootfs --ondisk sda --fstype=ext4 --label rootfs-a --align 1024 --fixed-size 8192M

part --source empty --ondisk sda --fstype=ext4 --label rootfs-b --align 1024 --fixed-size 8192M

part /home --source empty --ondisk sda --fstype=ext4 --label home --align 1024 --fixed-size 1024M

bootloader --ptable gpt --timeout=5 --append="root=LABEL=rootfs-a rootwait rw console=tty1 console=ttyS0,115200"
